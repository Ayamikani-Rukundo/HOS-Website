# Browser-safe values only. These are public keys protected by Supabase RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Local-only account seeding. Never provide these values to Vite or deploy them.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ALLOW_STAFF_ACCOUNT_PROVISIONING=false
ALLOW_DEV_ACCOUNTS=false
AUTO_GENERATE_DEV_ACCOUNTS=false
DEV_ACCOUNTS_JSON=[]